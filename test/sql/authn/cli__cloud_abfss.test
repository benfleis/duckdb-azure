# name: test/sql/authn/cli__cloud_abfss.test
# description: test cli authentication
# group: [authn]

##
# CI/cloud specific authn test, so don't include standard authn block
#
require-env AZ_CLI_LOGGED_IN

require-env AZURE_STORAGE_ACCOUNT

# standard requires -- see test/configs/cloud_abfss.yml
require azure

require parquet

# only run in cloud+abfss protocol mode
require-env AZURE_PROTOCOL abfss

require-env AZURE_PROVIDER cloud


# precondition: clear out any leftover secrets to be sure
# confirm no access, then confirm access
statement ok
DROP SECRET IF EXISTS abfss_authn;

statement error
SELECT count(*) FROM 'abfss://duckdblabs-data/common/azure_data/l.parquet';
----
Invalid Input Error: No valid Azure credentials found!

statement ok
CREATE SECRET abfss_authn (
    TYPE AZURE,
    PROVIDER CREDENTIAL_CHAIN,
    CHAIN 'cli',
    ACCOUNT_NAME '${AZURE_STORAGE_ACCOUNT}'
)

query I
SELECT count(*) FROM 'abfss://duckdblabs-data/common/azure_data/l.parquet';
----
60175
