# name: test/sql/authn/persistent_secret_p2_use__local_az.test
# description: test azure extension persistent secrets
# group: [authn]

##
# this test is not a singleton -- needs to be run after p1 to test and delete secret
#

# implies -> local/azurite only; not actively used here for filters during tests
require-env AZURE_STORAGE_CONNECTION_STRING

require-env TESTING_AZURE_PERSISTENT_SECRET 1

# standard requires -- see test/configs/cloud_az.yml
require azure

require parquet

# only run in local+az protocol mode
require-env AZURE_PROTOCOL az

require-env AZURE_PROVIDER local


statement ok
RESET secret_directory;

statement ok
SET allow_persistent_secrets=true;

# check the duckdb_secrets
query I
SELECT count(*) FROM duckdb_secrets() WHERE name = 'persistent_azure_authn' AND persistent = true;
----
1

# Read a column from a parquet file
query I
SELECT sum(l_orderkey) FROM 'az://testing-private/l.parquet';
----
1802759573

statement ok
DROP PERSISTENT SECRET persistent_azure_authn;
