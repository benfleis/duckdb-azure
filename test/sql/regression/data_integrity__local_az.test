# name: test/sql/regression/data_integrity__local_az.test
# description: Check the test data looks as expected
# group: [regression]

# TODO: confirm/deny and cleanup
#somehow broken in CI setting, requires bogus env variable to be enabled
# require-env ENABLE_DATA_INTEGRITY

# standard requires -- see test/configs/cloud_az.yml
require azure

require parquet

# only run in local+az protocol mode
require-env AZURE_PROTOCOL az

require-env AZURE_PROVIDER local

statement ok
SET allow_persistent_secrets=false

statement ok
CREATE OR REPLACE SECRET az_authn (
    TYPE AZURE,
    CONNECTION_STRING 'DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;',
    ACCOUNT_NAME 'devstoreaccount1'
);


# Note:
# * if this test fails, you probably added a file to `./data` when doing so, they need to be added here too
# * we add contains(file, '.') to avoid failure when using dfs storage (as DFS handle the idea of directory they are also part of the result)

### Check file listing
query I
SELECT file FROM glob("az://testing-private/**") WHERE contains(file, '.') ORDER BY file;
----
az://testing-private/README.md
az://testing-private/l.csv
az://testing-private/l.parquet
az://testing-private/lineitem.csv
az://testing-private/partitioned/l_receipmonth=1997/l_shipmode=AIR/data_0.csv
az://testing-private/partitioned/l_receipmonth=1997/l_shipmode=SHIP/data_0.csv
az://testing-private/partitioned/l_receipmonth=1997/l_shipmode=TRUCK/data_0.csv
az://testing-private/partitioned/l_receipmonth=1998/l_shipmode=AIR/data_0.csv
az://testing-private/partitioned/l_receipmonth=1998/l_shipmode=SHIP/data_0.csv
az://testing-private/partitioned/l_receipmonth=1998/l_shipmode=TRUCK/data_0.csv

