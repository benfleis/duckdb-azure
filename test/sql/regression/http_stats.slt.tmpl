# name: test/sql/regression/http_stats__{{ suffix }}.test
# description: confirm HTTP stats fall within expected values
# group: [regression]

{{ & azure_requires }}
{{ & azure_authn }}

# Enable http info for the explain analyze statement
statement ok
SET azure_http_stats = true;

query II
EXPLAIN ANALYZE SELECT sum(l_orderkey) FROM '{{ env.DATA_DIR }}/l.parquet';
----
analyzed_plan	<REGEX>:.*HTTP Stats.*\#HEAD\: [23].*GET\: [0-3].*PUT\: 0.*\#POST\: 0.*

