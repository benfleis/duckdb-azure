# name: test/sql/proxy/proxy_via_secret__cloud_abfss.test
# description: test azure extension with a simple proxy but configured with DuckDB secret
# group: [proxy]

require-env AZURE_STORAGE_CONNECTION_STRING

require-env HTTP_PROXY_RUNNING

# standard requires -- see test/configs/cloud_abfss.yml
require azure

require parquet

# only run in cloud+abfss protocol mode
require-env AZURE_PROTOCOL abfss

require-env AZURE_PROVIDER cloud


# Start with default provider
statement ok
CREATE SECRET azure_authn (
    TYPE AZURE,
    CONNECTION_STRING '${AZURE_STORAGE_CONNECTION_STRING}',
    http_proxy 'http://localhost:3128'
)

query I
SELECT count(*) FROM 'abfss://duckdblabs-data/common/azure_data/l.csv';
----
60175
