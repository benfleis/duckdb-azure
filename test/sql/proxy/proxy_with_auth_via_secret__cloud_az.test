# name: test/sql/proxy/proxy_with_auth_via_secret__cloud_az.test
# description: test azure extension with a proxy requiring an authentication
# group: [proxy]

require-env AZURE_STORAGE_CONNECTION_STRING

require-env HTTP_PROXY_RUNNING

# standard requires -- see test/configs/cloud_az.yml
require azure

require parquet

# only run in cloud+az protocol mode
require-env AZURE_PROTOCOL az

require-env AZURE_PROVIDER cloud


statement ok
SET azure_storage_connection_string = '${AZURE_STORAGE_CONNECTION_STRING}';

statement ok
SET azure_http_proxy = 'http://localhost:3129';

statement ok
SET azure_proxy_user_name = 'john';

statement ok
SET azure_proxy_password = 'doe';

query I
SELECT count(*) FROM 'az://duckdblabs-data/common/azure_data/l.csv';
----
60175
