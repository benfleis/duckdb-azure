# name: test/sql/proxy/proxy_via_secret__local_az.test
# description: test azure extension with a simple proxy but configured with DuckDB secret
# group: [proxy]

require-env AZURE_STORAGE_CONNECTION_STRING

require-env HTTP_PROXY_RUNNING

# standard requires -- see test/configs/cloud_az.yml
require azure

require parquet

# only run in local+az protocol mode
require-env AZURE_PROTOCOL az

require-env AZURE_PROVIDER local


# Start with default provider
statement ok
CREATE SECRET azure_authn (
    TYPE AZURE,
    CONNECTION_STRING '${AZURE_STORAGE_CONNECTION_STRING}',
    http_proxy 'http://localhost:3128'
)

query I
SELECT count(*) FROM 'az://testing-private/l.csv';
----
60175
