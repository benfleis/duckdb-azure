# name: test/sql/fs/glob__cloud_az.test
# description: test azure globbing
# group: [fs]

# standard requires -- see test/configs/cloud_az.yml
require azure

require parquet

# only run in cloud+az protocol mode
require-env AZURE_PROTOCOL az

require-env AZURE_PROVIDER cloud

require-env AZURE_AUTH_ENV 1

require-env AZURE_STORAGE_ACCOUNT

statement ok
SET allow_persistent_secrets=false

statement ok
CREATE OR REPLACE SECRET az_authn (
    TYPE AZURE,
    PROVIDER CREDENTIAL_CHAIN,
    ACCOUNT_NAME '${AZURE_STORAGE_ACCOUNT}'
);


# Testing known blobs
query I
SELECT * from GLOB("az://duckdblabs-data/common/azure_data/*.*") order by file;
----
az://duckdblabs-data/common/azure_data/README.md
az://duckdblabs-data/common/azure_data/l.csv
az://duckdblabs-data/common/azure_data/l.parquet
az://duckdblabs-data/common/azure_data/lineitem.csv

query I
SELECT * from GLOB("az://duckdblabs-data/common/azure_data/*.csv") order by file;
----
az://duckdblabs-data/common/azure_data/l.csv
az://duckdblabs-data/common/azure_data/lineitem.csv

query I
SELECT * from GLOB("az://duckdblabs-data/common/azure_data/*.parquet") order by file;
----
az://duckdblabs-data/common/azure_data/l.parquet

query I
SELECT * from GLOB("az://duckdblabs-data/common/azure_data/lineitem.*") order by file;
----
az://duckdblabs-data/common/azure_data/lineitem.csv

# Auto glob: ".../partitioned" -> ".../partitioned/*" via read_csv (and other multi file readers)
query II
SELECT l_shipmode, COUNT(*) FROM read_csv('az://duckdblabs-data/common/azure_data/partitioned') GROUP BY l_shipmode ORDER BY l_shipmode;
----
AIR	2318
SHIP	2301
TRUCK	2317

