# name: test/sql/fs/glob__local_az.test
# description: test azure globbing
# group: [fs]

# standard requires -- see test/configs/cloud_az.yml
require azure

require parquet

# only run in local+az protocol mode
require-env AZURE_PROTOCOL az

require-env AZURE_PROVIDER local

statement ok
SET allow_persistent_secrets=false

statement ok
CREATE OR REPLACE SECRET az_authn (
    TYPE AZURE,
    CONNECTION_STRING 'DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;',
    ACCOUNT_NAME 'devstoreaccount1'
);


# Testing known blobs
query I
SELECT * from GLOB("az://testing-private/*.*") order by file;
----
az://testing-private/README.md
az://testing-private/l.csv
az://testing-private/l.parquet
az://testing-private/lineitem.csv

query I
SELECT * from GLOB("az://testing-private/*.csv") order by file;
----
az://testing-private/l.csv
az://testing-private/lineitem.csv

query I
SELECT * from GLOB("az://testing-private/*.parquet") order by file;
----
az://testing-private/l.parquet

query I
SELECT * from GLOB("az://testing-private/lineitem.*") order by file;
----
az://testing-private/lineitem.csv

# Auto glob: ".../partitioned" -> ".../partitioned/*" via read_csv (and other multi file readers)
query II
SELECT l_shipmode, COUNT(*) FROM read_csv('az://testing-private/partitioned') GROUP BY l_shipmode ORDER BY l_shipmode;
----
AIR	2318
SHIP	2301
TRUCK	2317

