# name: test/sql/fs/abfss_specifics__cloud_abfss.test
# description: test azure extension with ADLS GEN2 storage
# group: [fs]

# standard requires -- see test/configs/cloud_abfss.yml
require azure

require parquet

# only run in cloud+abfss protocol mode
require-env AZURE_PROTOCOL abfss

require-env AZURE_PROVIDER cloud

require-env AZURE_AUTH_ENV 1

require-env AZURE_STORAGE_ACCOUNT

statement ok
SET allow_persistent_secrets=false

statement ok
CREATE OR REPLACE SECRET abfss_authn (
    TYPE AZURE,
    PROVIDER CREDENTIAL_CHAIN,
    ACCOUNT_NAME '${AZURE_STORAGE_ACCOUNT}'
);


# Check that with Azure ADLS GEN2 directories are not show in globs
query I
SELECT file FROM glob('abfss://duckdblabs-data/common/azure_data/**') ORDER BY file;
----
abfss://duckdblabs-data/common/azure_data/README.md
abfss://duckdblabs-data/common/azure_data/l.csv
abfss://duckdblabs-data/common/azure_data/l.parquet
abfss://duckdblabs-data/common/azure_data/lineitem.csv
abfss://duckdblabs-data/common/azure_data/partitioned/l_receipmonth=1997/l_shipmode=AIR/data_0.csv
abfss://duckdblabs-data/common/azure_data/partitioned/l_receipmonth=1997/l_shipmode=SHIP/data_0.csv
abfss://duckdblabs-data/common/azure_data/partitioned/l_receipmonth=1997/l_shipmode=TRUCK/data_0.csv
abfss://duckdblabs-data/common/azure_data/partitioned/l_receipmonth=1998/l_shipmode=AIR/data_0.csv
abfss://duckdblabs-data/common/azure_data/partitioned/l_receipmonth=1998/l_shipmode=SHIP/data_0.csv
abfss://duckdblabs-data/common/azure_data/partitioned/l_receipmonth=1998/l_shipmode=TRUCK/data_0.csv

# Check data integrity for Azure ADLS GEN2 storage account
statement error
SELECT file FROM glob('abfss://duckdblabs-data/common/azure_data/**/*.csv') ORDER BY file;
----
<REGEX>:.*Not implemented Error:.*abfss.*recursive lookup patterns.*

query I
SELECT count(*) FROM 'abfss://duckdblabs-data/common/azure_data/partitioned/l_receipmonth=*/l_shipmode=TRUCK/*.csv';
----
2317

query I
SELECT count(*) FROM 'abfss://duckdblabs-data/common/azure_data/partitioned/l_receipmonth=*/l_shipmode=*/*.csv';
----
6936

# Check with absolute path
query I
SELECT count(*) FROM 'abfss://duckdblabs-data/common/azure_data/partitioned/l_receipmonth=1997/l_shipmode=TRUCK/data_0.csv';
----
1291

# Check with absolute path using unsecure abfs
query I
SELECT count(*) FROM 'abfs://duckdblabs-data/common/azure_data/partitioned/l_receipmonth=1997/l_shipmode=TRUCK/data_0.csv';
----
1291

# Check fully qualified name
query I
SELECT count(*) FROM 'abfss://duckdblabstestdata.dfs.core.windows.net/duckdblabs-data/common/azure_data/partitioned/l_receipmonth=*/l_shipmode=TRUCK/*.csv';
----
2317

# Check fully qualified name using unsecure abfs
query I
SELECT count(*) FROM 'abfs://duckdblabstestdata.dfs.core.windows.net/duckdblabs-data/common/azure_data/partitioned/l_receipmonth=*/l_shipmode=TRUCK/*.csv';
----
2317

foreach proto abfs:// abfss://

# Check fully qualified name abfs[s] alternative syntax
query I
SELECT count(*) FROM read_csv(
  '${proto}' || 'duckdblabs-data' || '@duckdblabstestdata.dfs.core.windows.net/'
  || 'common/azure_data/partitioned/l_receipmonth=*/l_shipmode=TRUCK/*.csv'
);
----
2317

endloop

